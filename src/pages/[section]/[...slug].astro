---
import { render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { mdxComponents } from '@/components/mdx';
import { getLessons, lessonSection, lessonSlug, type Lesson } from '@/lib/content';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((entry) => {
    const section = lessonSection(entry);
    const siblings = lessons.filter((l) => lessonSection(l) === section);
    const i = siblings.indexOf(entry);
    const link = (l?: Lesson) => (l ? { title: l.data.title, href: `/${section}/${lessonSlug(l)}` } : undefined);
    return {
      params: { section, slug: lessonSlug(entry) },
      props: { entry, prev: link(siblings[i - 1]), next: link(siblings[i + 1]) },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const platformLabel = { mobile: 'Mobile', web: 'Web', both: 'Mobile & web' }[entry.data.platform];
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={lessonSection(entry)}
  headings={headings}
  minutes={entry.data.minutes}
  badges={[
    { label: entry.data.level, icon: 'signal' },
    { label: platformLabel, icon: 'tablet-smartphone' },
  ]}
  prev={prev}
  next={next}
>
  <Content components={mdxComponents} />
</DocsLayout>
