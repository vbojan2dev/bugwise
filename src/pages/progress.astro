---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import ProgressDashboard from '@/components/islands/ProgressDashboard';
import { getNav } from '@/lib/content';
import { getSection } from '@/data/site';

const nav = await getNav();
const catalog = nav
  .filter((g) => g.items.length)
  .map((g) => ({
    id: g.id,
    title: g.title,
    accent: getSection(g.id).accent,
    href: g.href,
    items: g.items.map((i) => ({ title: i.title, key: i.href.slice(1), href: i.href })),
  }));
---

<BaseLayout title="Your progress" description="Track the lessons and components you've completed. Saved in your browser, no account needed.">
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid absolute inset-0 -z-10 opacity-60"></div>
    <div class="container-page py-14">
      <span class="grid size-12 place-items-center rounded-2xl bg-brand text-brand-fg shadow-soft">
        <Icon name="trophy" size={24} />
      </span>
      <h1 class="mt-5 text-4xl font-bold tracking-tight sm:text-5xl">Your progress</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Mark pages as complete, finish quizzes and hunt bugs, and your progress shows up here. It's saved in this browser only, with no sign-up.
      </p>
    </div>
  </section>
  <div class="container-page py-10">
    <ProgressDashboard client:load catalog={catalog} />
  </div>
</BaseLayout>
