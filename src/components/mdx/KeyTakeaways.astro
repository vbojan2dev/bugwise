---
import Icon from '@/components/ui/Icon.astro';
---

<section class="takeaways not-prose relative my-10 overflow-hidden rounded-2xl border border-line p-6 sm:p-7">
  <div class="absolute inset-0 -z-10 opacity-60" style="background: radial-gradient(120% 120% at 0% 0%, var(--brand-soft), transparent 60%)"></div>
  <p class="mb-4 flex items-center gap-2 font-semibold">
    <span class="grid size-8 place-items-center rounded-xl bg-brand text-brand-fg"><Icon name="target" size={16} /></span>
    Key takeaways
  </p>
  <div class="takeaways-body"><slot /></div>
</section>

<style>
  .takeaways-body :global(ul) {
    display: grid;
    gap: 0.6rem;
  }
  .takeaways-body :global(li) {
    position: relative;
    padding-left: 1.9rem;
    line-height: 1.6;
    color: var(--fg);
  }
  .takeaways-body :global(li)::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.3rem;
    height: 1.3rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--ok-soft);
    color: var(--ok);
  }
</style>
