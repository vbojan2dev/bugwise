---
import Icon from '@/components/ui/Icon.astro';

interface Bug {
  title: string;
  hint?: string;
  detail: string;
}
interface Props {
  title?: string;
  bugs: Bug[];
}
const { title = 'Find the bugs', bugs } = Astro.props;
---

<section class="bughunt not-prose my-10 overflow-hidden rounded-3xl border border-line bg-subtle" data-bughunt>
  <div class="flex flex-wrap items-center gap-3 border-b border-line bg-surface px-5 py-4">
    <span class="grid size-10 place-items-center rounded-xl bg-danger-soft text-danger"><Icon name="bug" size={20} /></span>
    <div>
      <p class="font-semibold">🐞 Bug hunt: {title}</p>
      <p class="text-sm text-muted">This demo has <strong class="text-fg">{bugs.length} hidden bugs</strong>. Explore it like a tester, then check your findings.</p>
    </div>
    <div class="ml-auto flex items-center gap-2 text-sm">
      <span class="text-muted">Found</span>
      <span class="rounded-lg bg-surface px-2 py-0.5 font-mono font-semibold ring-1 ring-line" data-found>0/{bugs.length}</span>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-0 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div class="flex min-w-0 items-start justify-center p-4 sm:p-6">
      <slot />
    </div>
    <ol class="min-w-0 space-y-2.5 border-t border-line p-4 sm:p-6 lg:border-t-0 lg:border-l">
      {
        bugs.map((b, i) => (
          <li class="bug-item rounded-2xl border border-line bg-surface p-4 transition-colors" data-bug>
            <div class="flex items-start gap-3">
              <span class="bug-num mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-subtle text-xs font-semibold text-muted">{i + 1}</span>
              <div class="min-w-0 flex-1">
                <p class="bug-locked text-sm text-muted">{b.hint ? <>Hint: {b.hint}</> : 'Hidden bug'}</p>
                <div class="bug-open hidden">
                  <p class="font-semibold">{b.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-muted" set:html={b.detail} />
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button type="button" data-reveal class="rounded-lg border border-line px-2.5 py-1 text-xs font-medium text-muted hover:text-fg">
                    Reveal answer
                  </button>
                  <button type="button" data-found-btn class="rounded-lg border border-line px-2.5 py-1 text-xs font-medium text-muted hover:text-fg">
                    ✓ I found this
                  </button>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .bug-item.is-open .bug-locked { display: none; }
  .bug-item.is-open .bug-open { display: block; }
  .bug-item.is-found { border-color: color-mix(in oklab, var(--ok) 40%, transparent); background: color-mix(in oklab, var(--ok-soft) 60%, var(--surface)); }
  .bug-item.is-found .bug-num { background: var(--ok); color: white; }
  .bug-item.is-found [data-found-btn] { color: var(--ok); border-color: color-mix(in oklab, var(--ok) 40%, transparent); }
</style>

<script>
  import { currentKey, load, recordBugs } from '@/lib/progress';

  document.querySelectorAll<HTMLElement>('[data-bughunt]').forEach((root, huntIndex) => {
    const huntKey = currentKey() + (huntIndex ? `#${huntIndex}` : '');
    const items = [...root.querySelectorAll<HTMLElement>('[data-bug]')];
    const counter = root.querySelector('[data-found]')!;
    const found = () => items.flatMap((item, i) => (item.classList.contains('is-found') ? [i] : []));
    const update = () => {
      counter.textContent = `${found().length}/${items.length}`;
      recordBugs(huntKey, found(), items.length);
    };

    // Restore bugs found on an earlier visit.
    for (const i of load().bugs[huntKey]?.found ?? []) {
      items[i]?.classList.add('is-found', 'is-open');
      const reveal = items[i]?.querySelector('[data-reveal]');
      if (reveal) reveal.textContent = 'Hide answer';
    }
    counter.textContent = `${found().length}/${items.length}`;

    items.forEach((item) => {
      item.querySelector('[data-reveal]')!.addEventListener('click', (e) => {
        const open = item.classList.toggle('is-open');
        (e.currentTarget as HTMLElement).textContent = open ? 'Hide answer' : 'Reveal answer';
      });
      item.querySelector('[data-found-btn]')!.addEventListener('click', () => {
        item.classList.toggle('is-found');
        item.classList.add('is-open');
        item.querySelector('[data-reveal]')!.textContent = 'Hide answer';
        update();
      });
    });
  });
</script>
