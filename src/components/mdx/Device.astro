---
interface Props {
  type?: 'iphone' | 'android' | 'browser';
  url?: string;
  /** Screen width in px for phones. */
  width?: number;
}
const { type = 'iphone', url = 'example.com', width = 320 } = Astro.props;
---

{
  type === 'browser' ? (
    <div class="not-prose my-6 overflow-hidden rounded-2xl border border-line-strong bg-surface shadow-float">
      <div class="flex items-center gap-3 border-b border-line bg-subtle px-4 py-2.5">
        <div class="flex gap-1.5">
          <span class="size-3 rounded-full bg-[#ff5f57]" />
          <span class="size-3 rounded-full bg-[#febc2e]" />
          <span class="size-3 rounded-full bg-[#28c840]" />
        </div>
        <div class="mx-auto max-w-sm flex-1 truncate rounded-lg border border-line bg-surface px-3 py-1 text-center font-mono text-xs text-faint">
          {url}
        </div>
        <span class="w-[46px]" />
      </div>
      <div class="bg-bg">
        <slot />
      </div>
    </div>
  ) : (
    <div class="not-prose my-6 flex justify-center">
      <div
        class:list={['device relative bg-[#0c0d12] p-[11px] shadow-float ring-1 ring-black/10', type === 'iphone' ? 'rounded-[48px]' : 'rounded-[36px]']}
        style={`width: ${width + 22}px`}
      >
        <div
          class:list={['relative overflow-hidden bg-white text-[#0e1120]', type === 'iphone' ? 'rounded-[38px]' : 'rounded-[26px]']}
          style="aspect-ratio: 9 / 19.5"
        >
          {type === 'iphone' ? (
            <div class="absolute top-2.5 left-1/2 z-20 h-[26px] w-[92px] -translate-x-1/2 rounded-full bg-black" />
          ) : (
            <div class="absolute top-3 left-1/2 z-20 size-3 -translate-x-1/2 rounded-full bg-black" />
          )}
          <div class="flex items-center justify-between px-7 pt-3.5 text-[12px] font-semibold">
            <span>9:41</span>
            <span class="flex items-center gap-1 opacity-80">●●● ▮</span>
          </div>
          <div class="absolute inset-x-0 top-11 bottom-0 overflow-hidden">
            <slot />
          </div>
        </div>
      </div>
    </div>
  )
}
