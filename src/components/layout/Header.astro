---
import Icon from '@/components/ui/Icon.astro';
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import { href, stripBase } from '@/lib/url';
import type { NavGroup } from '@/lib/content';

interface Props {
  nav: NavGroup[];
}
const { nav } = Astro.props;
const current = stripBase(Astro.url.pathname);

const links = [
  { title: 'Fundamentals', href: '/fundamentals' },
  { title: 'Components', href: '/components' },
  { title: 'Features', href: '/features' },
  { title: 'Mobile', href: '/mobile' },
  { title: 'Web', href: '/web' },
  { title: 'Tutorials', href: '/tutorials' },
  { title: 'Interview', href: '/interview' },
  { title: 'Career', href: '/career' },
];
const isActive = (h: string) => current === h || current.startsWith(h + '/');
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-bg/75 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/65">
  <div class="container-page flex h-16 items-center gap-3 sm:gap-4">
    <Logo />
    <nav class="ml-4 hidden items-center gap-0.5 lg:flex xl:ml-6 xl:gap-1" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={href(l.href)}
            class:list={[
              'rounded-lg px-2 py-1.5 text-sm font-medium transition-colors xl:px-3',
              isActive(l.href) ? 'bg-subtle text-fg' : 'text-muted hover:text-fg',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.title}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
      <button
        type="button"
        data-search-open
        class="flex h-9 items-center gap-2 rounded-xl border border-line bg-subtle px-3 text-sm text-faint transition-colors hover:border-line-strong hover:text-muted sm:w-56 lg:w-9 lg:justify-center lg:px-0 xl:w-56 xl:justify-start xl:px-3"
        aria-label="Search"
      >
        <Icon name="search" size={16} />
        <span class="hidden sm:inline lg:hidden xl:inline">Search…</span>
        <kbd class="ml-auto hidden rounded-md border border-line bg-surface px-1.5 py-0.5 font-mono text-[11px] sm:inline lg:hidden xl:inline">⌘K</kbd>
      </button>
      <a
        href={href('/bites')}
        class:list={[
          'grid size-9 place-items-center rounded-xl border border-line transition-colors hover:text-fg',
          current === '/bites' ? 'text-brand' : 'text-muted',
        ]}
        aria-label="Bites: quick review cards"
        title="Bites: quick review cards"
      >
        <Icon name="zap" size={17} />
      </a>
      <a
        href={href('/progress')}
        class:list={[
          'hidden size-9 place-items-center rounded-xl border border-line transition-colors hover:text-fg sm:grid',
          current === '/progress' ? 'text-brand' : 'text-muted',
        ]}
        aria-label="Your progress"
        title="Your progress"
      >
        <Icon name="trophy" size={17} />
      </a>
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-xl border border-line text-muted transition-colors hover:text-fg"
        aria-label="Toggle dark mode"
      >
        <Icon name="sun" size={17} class="hidden dark:block" />
        <Icon name="moon" size={17} class="block dark:hidden" />
      </button>
      <MobileNav nav={nav} />
    </div>
  </div>
</header>

<script>
  const toggle = () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  };
  document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', toggle));
</script>
