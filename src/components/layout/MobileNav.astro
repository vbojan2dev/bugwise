---
import Icon from '@/components/ui/Icon.astro';
import { href, stripBase } from '@/lib/url';
import type { NavGroup } from '@/lib/content';

interface Props {
  nav: NavGroup[];
}
const { nav } = Astro.props;
const current = stripBase(Astro.url.pathname);
---

<button
  type="button"
  data-mobile-open
  class="grid size-9 place-items-center rounded-xl border border-line text-muted lg:hidden"
  aria-label="Open menu"
>
  <Icon name="menu" size={18} />
</button>

<dialog
  data-mobile-nav
  class="m-0 ml-auto h-dvh max-h-none w-[min(22rem,88vw)] max-w-none border-l border-line bg-bg p-0 text-fg shadow-float backdrop:bg-black/40 backdrop:backdrop-blur-sm"
>
  <div class="flex h-16 items-center justify-between border-b border-line px-5">
    <span class="font-semibold">Menu</span>
    <button type="button" data-mobile-close class="grid size-9 place-items-center rounded-xl text-muted hover:text-fg" aria-label="Close menu">
      <Icon name="x" size={18} />
    </button>
  </div>
  <nav class="space-y-5 overflow-y-auto p-5" aria-label="Mobile">
    {
      nav.map((g) => (
        <div>
          <a href={href(g.href)} class="flex items-center gap-2 text-sm font-semibold text-fg">
            <Icon name={g.icon} size={16} class="text-faint" />
            {g.title}
          </a>
          {g.items.length > 0 && (
            <ul class="mt-2 space-y-0.5 border-l border-line pl-3 ml-2">
              {g.items.map((i) => (
                <li>
                  <a
                    href={href(i.href)}
                    class:list={['block rounded-md px-2 py-1 text-sm', current === i.href ? 'text-brand font-medium' : 'text-muted']}
                  >
                    {i.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
    <a href={href('/bites')} class="flex items-center gap-2 border-t border-line pt-5 text-sm font-semibold text-fg">
      <Icon name="zap" size={16} class="text-faint" />
      Bites: quick review
    </a>
    <a href={href('/capstone')} class="flex items-center gap-2 text-sm font-semibold text-fg">
      <Icon name="flag" size={16} class="text-faint" />
      Capstone project
    </a>
    <a href={href('/progress')} class="flex items-center gap-2 text-sm font-semibold text-fg">
      <Icon name="trophy" size={16} class="text-faint" />
      Your progress
    </a>
  </nav>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-nav]');
  document.querySelector('[data-mobile-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-mobile-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
