---
import Icon from '@/components/ui/Icon.astro';
interface Props {
  items: string[];
  title?: string;
}
const { items, title = 'Coming soon' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-14">
      <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold tracking-wider text-faint uppercase">
        <Icon name="rocket" size={15} /> {title}
      </h2>
      <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((t) => (
          <li class="flex items-center gap-2.5 rounded-xl border border-dashed border-line px-4 py-3 text-sm text-muted">
            <span class="size-1.5 rounded-full bg-line-strong" />
            {t}
          </li>
        ))}
      </ul>
    </section>
  )
}
