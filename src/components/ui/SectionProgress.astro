---
// "2 of 5 completed" with a bar. Filled in on the client by ProgressMarks.
interface Props {
  keys: string[];
  class?: string;
}
const { keys, class: className } = Astro.props;
---

{
  keys.length > 0 && (
    <div class:list={['flex items-center gap-3 text-sm', className]} data-progress-keys={keys.join(',')}>
      <div class="h-2 w-40 overflow-hidden rounded-full bg-line">
        <div class="h-full w-0 rounded-full bg-gradient-to-r from-brand to-brand-2 transition-[width] duration-500" data-progress-bar />
      </div>
      <span class="text-muted">
        <span class="font-medium text-fg" data-progress-count>
          0 of {keys.length}
        </span>{' '}
        completed
      </span>
    </div>
  )
}
