<div class="flex h-[104px] w-[170px] flex-col justify-center gap-3 overflow-hidden rounded-xl bg-black/[0.05] px-4 dark:bg-white/[0.06]" aria-hidden="true">
  <div>
    <div class="mb-1.5 flex justify-between text-[10px] font-semibold text-muted"><span>Uploading</span><span>62%</span></div>
    <div class="flex h-1.5 items-center">
      <span class="h-full w-[62%] rounded-full bg-brand"></span>
      <span class="ml-1 h-full flex-1 rounded-full bg-brand/25"></span>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <span class="relative block size-[16px]">
      {[0, 45, 90, 135, 180, 225, 270, 315].map((deg, i) => (
