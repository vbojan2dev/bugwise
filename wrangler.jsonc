// Cloudflare Workers deploy config: serves the static site built into ./dist.
// Build: `npm run build`. Deploy: `npx wrangler deploy` (Cloudflare runs both on every push to main).
{
  "name": "bugwise",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get the site's own 404 page.
    "not_found_handling": "404-page",
    // /lesson and /lesson/ both work; canonical URLs end with a slash.
    "html_handling": "auto-trailing-slash"
  }
}
